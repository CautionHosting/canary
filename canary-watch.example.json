{
  "version": 1,
  "canary": {
    "url": "https://canary.example.com",
    "pcrs": "./canary-pcrs.json",
    "keys": "./canary-keys.json"
  },
  "poll_interval_seconds": 30,
  "heartbeat_interval_seconds": 300,
  "failure_threshold": 3,
  "targets": [
    {
      "id": "payments-prod",
      "webhooks": [
        {
          "id": "payments-ops",
          "url": "https://alerts.example.com/payments",
          "secret_env": "PAYMENTS_WEBHOOK_SECRET"
        },
        {
          "id": "payments-oncall",
          "url": "https://oncall.example.com/hooks/canary",
          "secret_env": "PAYMENTS_ONCALL_SECRET"
        }
      ]
    },
    {
      "id": "ai-prod",
      "webhooks": [
        {
          "id": "ai-ops",
          "url": "https://alerts.example.com/ai",
          "secret_env": "AI_WEBHOOK_SECRET"
        }
      ]
    }
  ]
}
