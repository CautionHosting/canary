{
  "version": 1,
  "canary": {
    "url": "https://canary.kobl.one",
    "pcrs": ".caution/trusted_hashes.json",
    "keys": "./canary-keys.json"
  },
  "poll_interval_seconds": 30,
  "heartbeat_interval_seconds": 300,
  "failure_threshold": 3,
  "targets": [
    {
      "id": "pq-demo",
      "webhooks": [
        {
          "id": "pq-demo-hook",
          "url": "http://localhost:8443",
          "secret_env": "PQ_WEBHOOK_SECRET"
        }
      ]
    }
  ]
}
